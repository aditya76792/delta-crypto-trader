# ─────────────────────────────────────────────────────────────────────────────
# Delta Crypto Trader — environment variables. Copy to .env (git-ignored).
# NEVER commit real keys. Create keys at Delta Exchange India → Account → API Keys.
# Trading-permission keys REQUIRE an IP whitelist on Delta India.
# ─────────────────────────────────────────────────────────────────────────────

# Exchange environment: prod (api.india.delta.exchange) | testnet (demo keys only)
DELTA_ENV=testnet
DELTA_API_KEY=
DELTA_API_SECRET=

# Mode: backtest | paper | live
TRADING_MODE=paper

# Real-money gate. Leave EMPTY unless you really intend to trade live.
# Live also needs: --confirm-live flag, a typed confirmation, a passing backtest report.
DELTA_LIVE_CONFIRM=
# Only for supervised headless servers (skips the typed prompt, not the other gates)
DELTA_LIVE_NONINTERACTIVE=

# Optional overrides
TRADER_SYMBOLS=BTCUSD,ETHUSD
TRADER_STRATEGY=ema_trend_scalp
TRADER_RESOLUTION=5m
TRADER_LEVERAGE=5
PAPER_STARTING_EQUITY_USD=1000
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_PER_TRADE_PCT=0.005
RISK_MAX_LEVERAGE=10
TRADER_LOG_LEVEL=INFO
# TRADER_DATA_DIR=./data
# TRADER_LOG_DIR=./logs
